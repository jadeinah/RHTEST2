        local guessingGame = safeWaitChain(PlayerGui, 15, "ArtClass", "GuessingGame")
        if not guessingGame then return end
        
        local chooseAWord = safeWaitChain(guessingGame, 5, "ChooseAWord")
        local midGameArtist = safeWaitChain(guessingGame, 5, "Mid-GameArtist")
        local artistsWordLabel = safeWaitChain(midGameArtist, 5, "ArtistsWord")

        local lastSentWord = ""
        local isProcessingGuess = false
        local lastGuessTime = tick() + 10 
        
        local isWaitingForNextRound = false
        if midGameArtist and midGameArtist.Visible then
            isWaitingForNextRound = true
            getgenv().ArtStatusText = "⏳ Waiting Next Round"
            getgenv().ArtStatusColor = Color3.fromRGB(255, 255, 100)
        else
            getgenv().ArtStatusText = "🎨 Art: Scanning..."
            getgenv().ArtStatusColor = Color3.fromRGB(200, 200, 200)
        end

        local function cleanWord(str) return string.match(string.gsub(string.gsub(str, "Your Drawing Subject:", ""), "[\n\r]", ""), "^%s*(.-)%s*$") end

        local function TypeAnswer(answer)
            local TextChatServiceLocal = game:GetService("TextChatService")
            local ReplicatedStorageLocal = game:GetService("ReplicatedStorage")
            
            task.wait(math.random(3, 7) / 10) 
            
            pcall(function()
                if TextChatServiceLocal.ChatVersion == Enum.ChatVersion.TextChatService then
                    local channels = TextChatServiceLocal:FindFirstChild("TextChannels")
                    if channels then
                        local rbxGeneral = channels:FindFirstChild("RBXGeneral")
                        if rbxGeneral then 
                            rbxGeneral:SendAsync(answer) 
                        end
                    end
                else
                    local chatEvent = ReplicatedStorageLocal:FindFirstChild("DefaultChatSystemChatEvents")
                    if chatEvent then
                        local sayMsg = chatEvent:FindFirstChild("SayMessageRequest")
                        if sayMsg then 
                            sayMsg:FireServer(answer, "All") 
                        end
                    end
                end
            end)
        end

        local function sendData(word)
            if not makeHttpRequest then return end
            task.spawn(function()
                pcall(function() makeHttpRequest({ Url = MY_API_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ server_id = SERVER_ID, answer = word }) }) end)
                pcall(function() makeHttpRequest({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ content = "🎨 **Server:** `" .. word .. "`", username = "Art Class Bot" }) }) end)
            end)
        end

        local function drawLineSafe(startX, startY, endX, endY)
            local safeWait = 0
            while getgenv().IsCaptchaActive and safeWait < 60 do task.wait(0.5); safeWait = safeWait + 1 end
            
            local steps = math.random(15, 25) 
            
            VirtualInputManager:SendMouseMoveEvent(startX, startY, game)
            task.wait(0.04) 
            VirtualInputManager:SendMouseButtonEvent(startX, startY, 0, true, game, 1)
            task.wait(0.02)
            
            for i = 1, steps do
                if getgenv().IsCaptchaActive then VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1) return end
                
                local t = i / steps
                local easeT = t * t * (3 - 2 * t) 
                
                local jitterX = math.random(-3, 3) 
                local jitterY = math.random(-3, 3)
                
                local currentX = startX + ((endX - startX) * easeT) + jitterX
                local currentY = startY + ((endY - startY) * easeT) + jitterY
                
                VirtualInputManager:SendMouseMoveEvent(currentX, currentY, game)
                task.wait(math.random(1, 3) / 100) 
            end
            
            VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1)
            task.wait(math.random(5, 15) / 100) 
        end

        local function drawChar(char, x, y, s)
            char = string.upper(char)
            if char == "A" then drawLineSafe(x,y+s,x+s/2,y) drawLineSafe(x+s/2,y,x+s,y+s) drawLineSafe(x+s*0.25,y+s*0.5,x+s*0.75,y+s*0.5)
            elseif char == "B" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s*0.8,y+s*0.25) drawLineSafe(x+s*0.8,y+s*0.25,x,y+s*0.5) drawLineSafe(x,y+s*0.5,x+s*0.8,y+s*0.75) drawLineSafe(x+s*0.8,y+s*0.75,x,y+s)
            elseif char == "C" then drawLineSafe(x+s,y,x,y) drawLineSafe(x,y,x,y+s) drawLineSafe(x,y+s,x+s,y+s)
            elseif char == "D" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s*0.8,y+s*0.5) drawLineSafe(x+s*0.8,y+s*0.5,x,y+s)
            elseif char == "E" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s,y) drawLineSafe(x,y+s*0.5,x+s*0.8,y+s*0.5) drawLineSafe(x,y+s,x+s,y+s)
            else task.wait(0.3) end 
        end

        local function startWritingWord(wordToDraw)
            if getgenv().IsDrawing then return end
            getgenv().IsDrawing = true
            
            getgenv().ArtStatusText = "🎨 Drawing..."
            getgenv().ArtStatusColor = Color3.fromRGB(170, 85, 255)
            
            task.spawn(function()
                local camera = workspace.CurrentCamera
                task.wait(math.random(25, 45) / 10) 
                local viewport = camera.ViewportSize
                local startX, startY, baseSize, baseSpacing = viewport.X * 0.25, viewport.Y * 0.45, 35, 45
                for i = 1, #wordToDraw do
                    if not midGameArtist.Visible then break end
                    local safeWait = 0
                    while getgenv().IsCaptchaActive and safeWait < 60 do task.wait(0.5); safeWait = safeWait + 1 end
                    drawChar(string.sub(wordToDraw, i, i), startX + ((i - 1) * baseSpacing) + math.random(-3, 5), startY + math.random(-4, 4), baseSize + math.random(-4, 4))
                    task.wait(math.random(1, 3) / 10) 
                end
                getgenv().IsDrawing = false
                getgenv().ArtStatusText = "🎨 Art: Scanning..."
                getgenv().ArtStatusColor = Color3.fromRGB(200, 200, 200)
            end)
        end

        if chooseAWord then
            chooseAWord:GetPropertyChangedSignal("Visible"):Connect(function()
                if chooseAWord.Visible then
                    task.spawn(function()
                        while getgenv().IsCaptchaActive do task.wait(0.5) end
                        task.wait(math.random(15, 30) / 10)
                        
                        local option1Btn = safeFind(chooseAWord, "Option1", "BG", "ModeButton", "Button")
                        
                        if option1Btn and option1Btn:IsA("GuiObject") then
                            pcall(function()
                                if option1Btn.AbsolutePosition.X == 0 and option1Btn.AbsolutePosition.Y == 0 then return end
                                
                                local absPos = option1Btn.AbsolutePosition
                                local absSize = option1Btn.AbsoluteSize
                                local clickX = absPos.X + (absSize.X / 2)
                                local clickY = absPos.Y + (absSize.Y / 2)
                                
                                local s, inset = pcall(function() return GuiService:GetGuiInset() end)
                                if s and inset then 
                                    clickY = clickY + inset.Y 
                                end
                                
                                if clickX < 55 and clickY < 55 then return end
                                
                                local offsetX = math.random(-5, 5)
                                local offsetY = math.random(-5, 5)
                                
                                local finalX = clickX + offsetX
                                local finalY = clickY + offsetY
                                
                                VirtualInputManager:SendMouseMoveEvent(finalX, finalY, game)
                                task.wait(0.1)
                                VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 1)
                                task.wait(0.1)
                                VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 1)
                            end)
                        end
                    end)
                end
            end)
        end

        if artistsWordLabel then
            artistsWordLabel:GetPropertyChangedSignal("Text"):Connect(function()
                task.wait(0.2) 
                if not midGameArtist.Visible then return end
                local cleanText = cleanWord(artistsWordLabel.ContentText)
                if cleanText and string.len(cleanText) > 1 and cleanText ~= lastSentWord then
                    lastSentWord = cleanText
                    sendData(cleanText)
                    startWritingWord(cleanText)
                end
            end)
        end

        if midGameArtist then
            midGameArtist:GetPropertyChangedSignal("Visible"):Connect(function()
                if midGameArtist.Visible then 
                    getgenv().IsDrawing = false
                else
                    if isWaitingForNextRound then
                        isWaitingForNextRound = false
                        getgenv().ArtStatusText = "🎨 Art: Scanning..."
                        getgenv().ArtStatusColor = Color3.fromRGB(200, 200, 200)
                    end
                end
            end)
        end

        -- 🟢 SMART ROUND DETECTOR LOGIC (Pumalit sa lumang "attemptedWords" bug)
        task.spawn(function()
            local lastTargetWord = ""
            local wordResetTimer = tick()

            while task.wait(3) do
                if isWaitingForNextRound or (midGameArtist and midGameArtist.Visible) or isProcessingGuess or not makeHttpRequest then continue end
                
                local pSuccess, response = pcall(function() return makeHttpRequest({ Url = MY_API_URL .. "?server_id=" .. SERVER_ID, Method = "GET" }) end)
                
                if pSuccess and response and response.StatusCode == 200 then
                    local dSuccess, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
                    if dSuccess and decoded.answer and decoded.answer ~= "" then
                        local finalAnswer = cleanWord(decoded.answer)
                        
                        if finalAnswer ~= "" and string.len(finalAnswer) > 1 then
                            
                            -- 💡 FIX: Kapag bagong word (o lumipas na ang 1.5 mins / bagong round), magre-reset ang utak niya
                            if finalAnswer ~= lastTargetWord or (tick() - wordResetTimer > 90) then
                                lastTargetWord = finalAnswer
                                wordResetTimer = tick()
                                isProcessingGuess = true 
                                
                                task.spawn(function()
                                    task.wait((math.random(20, 50) / 10) + ((math.random(15, 30) / 10) + (string.len(finalAnswer) * 0.2)))
                                    while getgenv().IsCaptchaActive do task.wait(0.5) end
                                    while (tick() - lastGuessTime) < math.random(14, 18) do task.wait(0.5) end
                                    
                                    if guessingGame.Visible and not midGameArtist.Visible then
                                        local rng = math.random(1, 100)
                                        if rng <= 90 then
                                            getgenv().ArtStatusText = "💬 Answering"
                                            getgenv().ArtStatusColor = Color3.fromRGB(85, 255, 127)
                                            
                                            pcall(function() 
                                                TypeAnswer(finalAnswer)
                                                lastGuessTime = tick() 
                                            end)
                                        else
                                            getgenv().ArtStatusText = "💤 Skipped (10%)"
                                            getgenv().ArtStatusColor = Color3.fromRGB(255, 85, 85)
                                            
                                            pcall(function()
                                                lastGuessTime = tick() 
                                            end)
                                        end
                                    end
                                    
                                    isProcessingGuess = false 
                                    
                                    -- 💡 FIX: I-reset pabalik sa "Scanning..." ang text makalipas ang 15 seconds
                                    task.wait(15)
                                    if getgenv().ArtStatusText == "💬 Answering" or getgenv().ArtStatusText == "💤 Skipped (10%)" then
                                        getgenv().ArtStatusText = "🎨 Art: Scanning..."
                                        getgenv().ArtStatusColor = Color3.fromRGB(200, 200, 200)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end)
    end)
end
