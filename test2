                pcall(function() makeHttpRequest({ Url = MY_API_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ server_id = SERVER_ID, answer = word }) }) end)
                pcall(function() makeHttpRequest({ Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ content = "🎨 **Server:** `" .. word .. "`", username = "Art Class Bot" }) }) end)
            end)
        end

        -- 🛡️ BAGONG FUNCTION: Human-like Drawing (No more straight lines)
        local function drawLineSafe(startX, startY, endX, endY)
            local safeWait = 0
            while getgenv().IsCaptchaActive and safeWait < 60 do task.wait(0.5); safeWait = safeWait + 1 end
            
            local steps = math.random(15, 25) -- Mas madaming steps = mas mukhang natural
            
            VirtualInputManager:SendMouseMoveEvent(startX, startY, game)
            task.wait(0.04) 
            VirtualInputManager:SendMouseButtonEvent(startX, startY, 0, true, game, 1)
            task.wait(0.02)
            
            for i = 1, steps do
                if getgenv().IsCaptchaActive then VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1) return end
                
                local t = i / steps
                local easeT = t * t * (3 - 2 * t) -- Easing function para hindi constant ang speed
                
                local jitterX = math.random(-3, 3) -- Hand jitter
                local jitterY = math.random(-3, 3)
                
                local currentX = startX + ((endX - startX) * easeT) + jitterX
                local currentY = startY + ((endY - startY) * easeT) + jitterY
                
                VirtualInputManager:SendMouseMoveEvent(currentX, currentY, game)
                task.wait(math.random(1, 3) / 100) 
            end
            
            VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1)
            task.wait(math.random(5, 15) / 100) 
        end

        local function drawChar(char, x, y, s)
            char = string.upper(char)
            if char == "A" then drawLineSafe(x,y+s,x+s/2,y) drawLineSafe(x+s/2,y,x+s,y+s) drawLineSafe(x+s*0.25,y+s*0.5,x+s*0.75,y+s*0.5)
            elseif char == "B" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s*0.8,y+s*0.25) drawLineSafe(x+s*0.8,y+s*0.25,x,y+s*0.5) drawLineSafe(x,y+s*0.5,x+s*0.8,y+s*0.75) drawLineSafe(x+s*0.8,y+s*0.75,x,y+s)
            elseif char == "C" then drawLineSafe(x+s,y,x,y) drawLineSafe(x,y,x,y+s) drawLineSafe(x,y+s,x+s,y+s)
            elseif char == "D" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s*0.8,y+s*0.5) drawLineSafe(x+s*0.8,y+s*0.5,x,y+s)
            elseif char == "E" then drawLineSafe(x,y,x,y+s) drawLineSafe(x,y,x+s,y) drawLineSafe(x,y+s*0.5,x+s*0.8,y+s*0.5) drawLineSafe(x,y+s,x+s,y+s)
            else task.wait(0.3) end 
        end

        local function startWritingWord(wordToDraw)
            if getgenv().IsDrawing then return end
            getgenv().IsDrawing = true
            task.spawn(function()
                local camera = workspace.CurrentCamera
                task.wait(math.random(25, 45) / 10) 
                local viewport = camera.ViewportSize
                local startX, startY, baseSize, baseSpacing = viewport.X * 0.25, viewport.Y * 0.45, 35, 45
                for i = 1, #wordToDraw do
                    if not midGameArtist.Visible then break end
                    local safeWait = 0
                    while getgenv().IsCaptchaActive and safeWait < 60 do task.wait(0.5); safeWait = safeWait + 1 end
                    drawChar(string.sub(wordToDraw, i, i), startX + ((i - 1) * baseSpacing) + math.random(-3, 5), startY + math.random(-4, 4), baseSize + math.random(-4, 4))
                    task.wait(math.random(1, 3) / 10) 
                end
                getgenv().IsDrawing = false
            end)
        end

        if chooseAWord then
            chooseAWord:GetPropertyChangedSignal("Visible"):Connect(function()
                if chooseAWord.Visible and option1Button then
                    task.spawn(function()
                        while getgenv().IsCaptchaActive do task.wait(0.5) end
                        task.wait(math.random(15, 30) / 10)
                        
                        -- 🛡️ Tinanggal ang firesignal para iwas ban
                        pcall(function()
                            local pos = option1Button.AbsolutePosition + (option1Button.AbsoluteSize / 2)
                            local s, inset = pcall(function() return GuiService:GetGuiInset() end)
                            local y = pos.Y + (s and inset.Y or 0) + 36 
                            
                            local randomOffset = math.random(-5, 5)
                            VirtualInputManager:SendMouseMoveEvent(pos.X + randomOffset, y + randomOffset, game)
                            task.wait(0.1)
                            VirtualInputManager:SendMouseButtonEvent(pos.X + randomOffset, y + randomOffset, 0, true, game, 1)
                            task.wait(0.1)
                            VirtualInputManager:SendMouseButtonEvent(pos.X + randomOffset, y + randomOffset, 0, false, game, 1)
                        end)
                    end)
                end
            end)
        end

        if artistsWordLabel then
            artistsWordLabel:GetPropertyChangedSignal("Text"):Connect(function()
                task.wait(0.2) 
                if not midGameArtist.Visible then return end
                local cleanText = cleanWord(artistsWordLabel.ContentText)
                if cleanText and string.len(cleanText) > 1 and cleanText ~= lastSentWord then
                    lastSentWord = cleanText
                    sendData(cleanText)
                    startWritingWord(cleanText)
                end
            end)
        end

        if midGameArtist then
            midGameArtist:GetPropertyChangedSignal("Visible"):Connect(function()
                if midGameArtist.Visible then getgenv().IsDrawing = false; attemptedWords = {} end
            end)
        end

        task.spawn(function()
            while task.wait(3) do
                if (midGameArtist and midGameArtist.Visible) or isProcessingGuess or not makeHttpRequest then continue end
                local pSuccess, response = pcall(function() return makeHttpRequest({ Url = MY_API_URL .. "?server_id=" .. SERVER_ID, Method = "GET" }) end)
                if pSuccess and response and response.StatusCode == 200 then
                    local dSuccess, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
                    if dSuccess and decoded.answer and decoded.answer ~= "" then
                        local finalAnswer = cleanWord(decoded.answer)
                        if finalAnswer ~= "" and string.len(finalAnswer) > 1 and not attemptedWords[finalAnswer] then
                            attemptedWords[finalAnswer] = true; isProcessingGuess = true 
                            task.spawn(function()
                                task.wait((math.random(20, 50) / 10) + ((math.random(15, 30) / 10) + (string.len(finalAnswer) * 0.2)))
                                while getgenv().IsCaptchaActive do task.wait(0.5) end
                                while (tick() - lastGuessTime) < math.random(14, 18) do task.wait(0.5) end
                                
                                -- 🛡️ Updated logic: 90% chance sumagot, 10% chance mag-skip
                                if guessingGame.Visible and not midGameArtist.Visible then
                                    local rng = math.random(1, 100)
                                    if rng <= 90 then
                                        pcall(function() 
                                            TypeAnswer(finalAnswer)
                                            lastGuessTime = tick() 
                                        end)
                                    else
                                        -- Sinadyang HINDI sumagot para magmukhang totoong tao
                                        pcall(function()
                                            lastGuessTime = tick() 
                                        end)
                                    end
                                end
                                
                                isProcessingGuess = false 
                            end)
                        end
                    end
                end
            end
        end)
    end)
end
